package main
 
import (
	"bufio"
	"fmt"
	"os"
)
 
func main() {
	in := bufio.NewReaderSize(os.Stdin, 1<<20)
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
 
	var t int
	fmt.Fscan(in, &t)
	for ; t > 0; t-- {
		var n int
		fmt.Fscan(in, &n)
		mx, mn := -1, int(2e9)
		for i := 0; i < n; i++ {
			var a int
			fmt.Fscan(in, &a)
			if a > mx {
				mx = a
			}
			if a < mn {
				mn = a
			}
		}
		ans := mx
		if n > 1 {
			for c := 30; c >= 0; c-- {
				if mx>>c&1 == 0 {
					continue
				}
				y := (mx &^ (1<<(c+1) - 1)) | (1<<c - 1)
				if mn <= y {
					ans = mx | (1<<c - 1)
					break
				}
			}
		}
		fmt.Fprintln(out, ans)
	}
}